@model IEnumerable<WEB_BAN_NONG_SAN.Controllers.ProductItem>
@{
    ViewData["Title"] = "Danh sách nông sản";
    var categories = ViewBag.Categories as IEnumerable<WEB_BAN_NONG_SAN.Controllers.CategoryItem>;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container mt-4">
    <div class="row g-4">
        <!-- BỘ LỌC TÌM KIẾM BÊN TRÁI -->
        <div class="col-12 col-lg-3">
            <div class="bg-white p-4 rounded-4 shadow-sm">
                <h5 class="fw-bold text-success mb-3">
                    <i class="bi bi-funnel-fill me-2"></i>Tìm Kiếm & Lọc
                </h5>
                <form asp-controller="Products" asp-action="Index" method="get">
                    <!-- 6. Tìm kiếm theo tên -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên nông sản</label>
                        <input type="text" name="searchString" value="@ViewBag.SearchString"
                               class="form-control form-control-sm" placeholder="VD: Cam Vinh, Cà chua..." />
                    </div>

                    <!-- 7. Lọc theo danh mục -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Danh mục</label>
                        <select name="categoryId" class="form-select form-select-sm">
                            <option value="">-- Tất cả danh mục --</option>
                            @if (categories != null)
                            {
                                foreach (var cat in categories)
                                {
                                    <option value="@cat.Id" selected="@(ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- 7. Lọc theo khoảng giá -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Khoảng giá (VNĐ)</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="number" name="minPrice" value="@ViewBag.MinPrice"
                                   class="form-control form-control-sm" placeholder="Từ" min="0" step="5000" />
                            <span>-</span>
                            <input type="number" name="maxPrice" value="@ViewBag.MaxPrice"
                                   class="form-control form-control-sm" placeholder="Đến" min="0" step="5000" />
                        </div>
                    </div>

                    <!-- 8. Sắp xếp -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Sắp xếp theo</label>
                        <select name="sortOrder" class="form-select form-select-sm">
                            <option value="newest" selected="@(ViewBag.SortOrder == "newest")">Sản phẩm mới nhất</option>
                            <option value="price_asc" selected="@(ViewBag.SortOrder == "price_asc")">Giá: Thấp đến Cao</option>
                            <option value="price_desc" selected="@(ViewBag.SortOrder == "price_desc")">Giá: Cao đến Thấp</option>
                            <option value="name_asc" selected="@(ViewBag.SortOrder == "name_asc")">Tên: A - Z</option>
                            <option value="name_desc" selected="@(ViewBag.SortOrder == "name_desc")">Tên: Z - A</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-sm fw-bold py-2">
                            <i class="bi bi-check2-circle me-1"></i>Áp dụng bộ lọc
                        </button>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            Đặt lại mặc định
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- DANH SÁCH SẢN PHẨM BÊN PHẢI -->
        <div class="col-12 col-lg-9">
            <div class="bg-white p-3 rounded-4 shadow-sm mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    Tìm thấy <strong class="text-success">@(ViewBag.TotalItems ?? 0)</strong> sản phẩm nông sản
                </div>
                <div class="small text-muted">
                    Trang @currentPage / @(Math.Max(1, totalPages))
                </div>
            </div>

            <div class="row g-3">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="product-card h-100 d-flex flex-column">
                                <div class="product-img-wrapper">
                                    @if (item.IsNew)
                                    {
                                        <span class="badge bg-danger position-absolute top-0 start-0 m-2">Mới</span>
                                    }
                                    <img src="@item.ImageUrl" alt="@item.Name" />
                                </div>
                                <div class="card-body d-flex flex-column p-3">
                                    <span class="badge bg-success-subtle text-success align-self-start mb-2">@item.CategoryName</span>
                                    <h6 class="card-title fw-bold text-truncate" title="@item.Name">@item.Name</h6>
                                    <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>@item.Origin</p>
                                    <div class="mb-3">
                                        <span class="text-danger fw-bold fs-5">@item.Price.ToString("N0") đ</span>
                                        <span class="text-muted small">/ @item.Unit</span>
                                    </div>
                                    <div class="mt-auto d-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm flex-grow-1 fw-semibold">
                                            Xem chi tiết
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-success btn-sm">
                                            <i class="bi bi-cart-plus"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="bg-white p-5 text-center rounded-4 shadow-sm">
                            <i class="bi bi-search fs-1 text-muted"></i>
                            <h5 class="mt-3 fw-bold">Không tìm thấy sản phẩm phù hợp</h5>
                            <p class="text-muted small">Bạn hãy thử thay đổi từ khóa tìm kiếm hoặc khoảng giá lọc nhé.</p>
                            <a asp-action="Index" class="btn btn-success btn-sm">Xem tất cả sản phẩm</a>
                        </div>
                    </div>
                }
            </div>

            <!-- 9. PHÂN TRANG -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-searchString="@ViewBag.SearchString"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-minPrice="@ViewBag.MinPrice"
                               asp-route-maxPrice="@ViewBag.MaxPrice"
                               asp-route-sortOrder="@ViewBag.SortOrder">Trước</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-categoryId="@ViewBag.CategoryId"
                                   asp-route-minPrice="@ViewBag.MinPrice"
                                   asp-route-maxPrice="@ViewBag.MaxPrice"
                                   asp-route-sortOrder="@ViewBag.SortOrder">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-searchString="@ViewBag.SearchString"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-minPrice="@ViewBag.MinPrice"
                               asp-route-maxPrice="@ViewBag.MaxPrice"
                               asp-route-sortOrder="@ViewBag.SortOrder">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>