
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Nông Sản Xanh</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS website -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/WEB_BAN_NONG_SAN.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- HEADER, MENU VÀ TÌM KIẾM -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-agri py-3">
            <div class="container">

                <!-- Logo website -->
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">
                    <span>🌿 NÔNG SẢN XANH</span>
                </a>

                <!-- Menu trên điện thoại -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- Menu chính -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 fw-semibold">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Products"
                               asp-action="Index">
                                <i class="bi bi-grid me-1"></i>
                                Sản phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">
                                <i class="bi bi-info-circle me-1"></i>
                                Giới thiệu
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">
                                <i class="bi bi-envelope me-1"></i>
                                Liên hệ
                            </a>
                        </li>

                    </ul>

                    <!-- Tìm kiếm sản phẩm -->
                    <form class="d-flex me-lg-3 my-2 my-lg-0"
                          asp-controller="Products"
                          asp-action="Index"
                          method="get">

                        <div class="input-group">

                            <input class="form-control border-0"
                                   type="search"
                                   name="searchString"
                                   value="@(Context.Request.Query["searchString"].ToString())"
                                   placeholder="Tìm kiếm nông sản..."
                                   aria-label="Tìm kiếm sản phẩm" />

                            <button class="btn btn-warning fw-bold px-3"
                                    type="submit"
                                    aria-label="Tìm kiếm">

                                <i class="bi bi-search"></i>
                            </button>

                        </div>
                    </form>

                    <!-- Giỏ hàng và tài khoản -->
                    <div class="d-flex align-items-center flex-wrap gap-2 mt-2 mt-lg-0">

                        <!-- Liên kết tạm đến sản phẩm.
                             Sẽ nối vào CartController khi hoàn thiện giỏ hàng. -->
                        <a class="btn btn-outline-light btn-sm px-3 py-2"
                           asp-controller="Products"
                           asp-action="Index">

                            <i class="bi bi-cart3 me-1"></i>
                            Giỏ hàng
                        </a>

                        <!-- GIỮ CHỨC NĂNG TÀI KHOẢN -->
                        <div class="d-flex align-items-center">
                            <partial name="_LoginPartial" />
                        </div>

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- NỘI DUNG CÁC TRANG -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="footer-agri pt-5 pb-3 mt-auto">

        <div class="container">

            <div class="row g-4">

                <!-- Giới thiệu website -->
                <div class="col-12 col-md-4">

                    <h5 class="text-white fw-bold mb-3">
                        🌿 NÔNG SẢN XANH
                    </h5>

                    <p class="small mb-2">
                        Hệ thống cung cấp nông sản sạch,
                        rau củ quả và trái cây tươi
                        từ nông trại đến bàn ăn gia đình Việt.
                    </p>

                </div>

                <!-- Danh mục -->
                <div class="col-6 col-md-4">

                    <h6 class="text-white fw-bold mb-3">
                        Danh mục trang
                    </h6>

                    <ul class="list-unstyled small">

                        <li class="mb-2">
                            <a class="text-decoration-none text-light"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-decoration-none text-light"
                               asp-controller="Products"
                               asp-action="Index">
                                Danh sách sản phẩm
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-decoration-none text-light"
                               asp-controller="Home"
                               asp-action="About">
                                Giới thiệu
                            </a>
                        </li>

                        <li class="mb-2">
                            <a class="text-decoration-none text-light"
                               asp-controller="Home"
                               asp-action="Contact">
                                Liên hệ
                            </a>
                        </li>

                    </ul>
                </div>

                <!-- Thông tin liên hệ -->
                <div class="col-6 col-md-4">

                    <h6 class="text-white fw-bold mb-3">
                        Liên hệ hỗ trợ
                    </h6>

                    <p class="small mb-1">
                        <i class="bi bi-geo-alt-fill me-2 text-warning"></i>
                        TP. Vinh, Nghệ An
                    </p>

                    <p class="small mb-1">
                        <i class="bi bi-telephone-fill me-2 text-warning"></i>
                        0988 123 456
                    </p>

                    <p class="small mb-1">
                        <i class="bi bi-envelope-fill me-2 text-warning"></i>
                        hotro@nongsanxanh.vn
                    </p>

                </div>

            </div>

            <hr class="border-secondary my-3" />

            <div class="text-center small text-secondary">
                &copy; @DateTime.Now.Year -
                Website Bán Nông Sản Sạch.
                All rights reserved.
            </div>

        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
