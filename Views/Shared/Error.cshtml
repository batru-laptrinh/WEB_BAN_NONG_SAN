@model ErrorViewModel
@{ ViewData["Title"] = "Chưa thể xử lý yêu cầu"; }
<section class="account-result-card">
    <a class="auth-brand-link" asp-controller="Home" asp-action="Index"><partial name="_Brand" /></a>
    <p class="account-eyebrow">VUI LÒNG THỬ LẠI SAU</p>
    <h1>Chưa thể xử lý yêu cầu</h1>
    <p>Có sự cố trong lúc tải thông tin. Bạn có thể trở về cửa hàng và thử lại sau.</p>
    <p>Nếu bạn vừa xác nhận đặt hàng, hãy kiểm tra danh sách đơn hàng trước khi gửi lại.</p>
    <a class="store-button account-submit" asp-controller="Orders" asp-action="Index">Kiểm tra đơn hàng</a>
    <a class="account-inline-link" asp-controller="Home" asp-action="Index">Trở về trang chủ</a>
    @if (Model.ShowRequestId)
    {
        <p class="account-help mt-4">Mã hỗ trợ: <code class="text-break">@Model.RequestId</code></p>
    }
</section>
