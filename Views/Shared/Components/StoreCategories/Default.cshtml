@model IReadOnlyList<WEB_BAN_NONG_SAN.ViewModels.CatalogCategory>
<div class="dropdown store-category-menu">
    <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Danh mục</button>
    <ul class="dropdown-menu">
        @foreach (var category in Model)
        {
            <li><a class="dropdown-item" asp-area="" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a></li>
        }
        @if (Model.Count > 0) { <li><hr class="dropdown-divider" /></li> }
        <li><a class="dropdown-item" asp-area="" asp-controller="Catalog" asp-action="Index" asp-fragment="catalog-category">Xem tất cả danh mục</a></li>
    </ul>
</div>
