@model WEB_BAN_NONG_SAN.ViewModels.OrderDetailsViewModel
@using WEB_BAN_NONG_SAN.ViewModels
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<a asp-action="Index" class="d-inline-block mb-3">← Đơn hàng của tôi</a>
<div class="mb-4"><h1 class="h3 text-break">Đơn hàng @Model.Code</h1><p class="text-muted">Đặt lúc @Model.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (GMT+7)</p><span class="badge bg-light text-dark border fs-6">@OrderDisplay.Status(Model.Status)</span></div>
@if (TempData["SuccessMessage"] is string success) {<div role="status" class="alert alert-success">@success</div>}
@if (TempData["ErrorMessage"] is string error) {<div role="alert" class="alert alert-danger">@error</div>}
<partial name="_OrderContent" model="Model" />
@foreach (var action in Model.Actions)
{
    <section class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h5">Hủy đơn hàng này?</h2><p>Bạn có thể hủy khi đơn còn chờ xác nhận. Sản phẩm sẽ được hoàn lại tồn kho. Lượt sử dụng mã giảm giá vẫn được tính.</p>
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="confirmation" value="@action.Confirmation" />
            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="confirmed" value="true" id="confirm-cancel" required /><label class="form-check-label" for="confirm-cancel">Tôi xác nhận muốn hủy đơn hàng này.</label></div>
            <button class="btn btn-outline-danger" type="submit">@action.Label</button>
        </form>
    </div></section>
}
