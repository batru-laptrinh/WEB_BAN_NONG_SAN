@model WEB_BAN_NONG_SAN.ViewModels.CatalogIndexViewModel
@using System.Globalization
@{ ViewData["Title"] = "Cửa hàng nông sản"; }
<nav class="store-breadcrumb" aria-label="Đường dẫn"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span aria-hidden="true">/</span><span>Cửa hàng</span></nav>
<section class="store-page-heading"><div><p class="store-eyebrow">CHỌN CHO BỮA ĂN HÔM NAY</p><h1>Cửa hàng nông sản</h1><p>Tìm điều bạn cần, từ danh mục đến từng sản phẩm.</p></div><span class="store-heading-flower" aria-hidden="true">❧</span></section>
<div class="store-catalog-layout">
    <aside class="store-filter"><h2>Tìm sản phẩm</h2><form asp-action="Index" method="get"><div asp-validation-summary="All" class="text-danger small" role="alert"></div><label for="catalog-q">Tên sản phẩm</label><input id="catalog-q" name="q" value="@Model.Query.Q" maxlength="100" class="form-control" placeholder="Bạn đang tìm gì?" />
    <label for="catalog-category">Danh mục</label><select id="catalog-category" name="categoryId" class="form-select"><option value="">Tất cả danh mục</option>@foreach (var category in Model.Categories){<option value="@category.Id" selected="@(Model.Query.CategoryId == category.Id)">@category.Name</option>}</select>
    <label for="catalog-min">Giá từ (₫)</label><input id="catalog-min" name="minPrice" value="@Model.Query.MinPrice?.ToString(CultureInfo.InvariantCulture)" type="number" min="0" max="1000000000" step="1" class="form-control" placeholder="0" />
    <label for="catalog-max">Giá đến (₫)</label><input id="catalog-max" name="maxPrice" value="@Model.Query.MaxPrice?.ToString(CultureInfo.InvariantCulture)" type="number" min="0" max="1000000000" step="1" class="form-control" placeholder="Không giới hạn" />
    <label for="catalog-sort">Sắp xếp</label><select id="catalog-sort" name="sort" class="form-select"><option value="newest" selected="@(Model.Query.Sort == "newest")">Mới nhất</option><option value="name" selected="@(Model.Query.Sort == "name")">Tên A — Z</option><option value="price-asc" selected="@(Model.Query.Sort == "price-asc")">Giá tăng dần</option><option value="price-desc" selected="@(Model.Query.Sort == "price-desc")">Giá giảm dần</option></select><button type="submit" class="store-button w-100">Áp dụng bộ lọc</button><a asp-action="Index" class="store-clear-filter">Xóa bộ lọc</a></form></aside>
    <section aria-label="Kết quả sản phẩm" class="store-catalog-results">
    @if (!Model.IsDataAvailable)
    {
        <div class="store-empty" role="status"><h2>Chưa tải được sản phẩm</h2><p>Vui lòng thử lại sau. Thông tin sản phẩm hiện chưa khả dụng.</p></div>
    }
    else
    {
        <div class="store-results-top"><p><strong>@Model.TotalCount</strong> sản phẩm phù hợp</p><span>Trang @Model.Query.Page / @Model.TotalPages</span></div>
        @if (Model.Products.Count == 0)
        {
            <div class="store-empty"><span class="store-empty-icon" aria-hidden="true">❧</span><h2>Chưa tìm thấy sản phẩm</h2><p>Thử từ khóa khác hoặc mở rộng bộ lọc của bạn.</p><a asp-action="Index" class="store-button store-button-outline">Xem tất cả sản phẩm</a></div>
        }
        else { <div class="store-product-grid store-catalog-grid">@foreach (var product in Model.Products){<partial name="_ProductCard" model="product" />}</div> }
        @if (Model.TotalPages > 1)
        {
            <nav class="store-pagination" aria-label="Phân trang sản phẩm">
                @if (Model.Query.Page > 1){<a asp-action="Index" asp-route-q="@Model.Query.Q" asp-route-categoryId="@Model.Query.CategoryId" asp-route-minPrice="@Model.Query.MinPrice" asp-route-maxPrice="@Model.Query.MaxPrice" asp-route-sort="@Model.Query.Sort" asp-route-page="@(Model.Query.Page-1)" rel="prev">← Trước</a>}
                <span aria-current="page">@Model.Query.Page / @Model.TotalPages</span>
                @if (Model.Query.Page < Model.TotalPages){<a asp-action="Index" asp-route-q="@Model.Query.Q" asp-route-categoryId="@Model.Query.CategoryId" asp-route-minPrice="@Model.Query.MinPrice" asp-route-maxPrice="@Model.Query.MaxPrice" asp-route-sort="@Model.Query.Sort" asp-route-page="@(Model.Query.Page+1)" rel="next">Sau →</a>}
            </nav>
        }
    }
    </section>
</div>
