@model WEB_BAN_NONG_SAN.ViewModels.CatalogDetailsViewModel
@using System.Globalization
@{
    ViewData["Title"] = Model.Product.Name;
    var hasImage = !string.IsNullOrWhiteSpace(Model.Product.ImagePath);
}
<nav class="store-breadcrumb" aria-label="Đường dẫn">
    <a asp-controller="Home" asp-action="Index">Trang chủ</a><span aria-hidden="true">/</span><a asp-action="Index">Cửa hàng</a><span aria-hidden="true">/</span><span aria-current="page">@Model.Product.Name</span>
</nav>
<article class="store-product-detail">
    <div class="store-detail-media">
        <div class="store-detail-picture @(hasImage ? "" : "is-placeholder")">
            <img data-product-image data-fallback-src="@Url.Content("~/images/agriculture-harvest.webp")" src="@(hasImage ? Model.Product.ImagePath : Url.Content("~/images/agriculture-harvest.webp"))"
                 alt="@(hasImage ? Model.Product.Name : "Chưa có ảnh sản phẩm — ảnh minh họa rau củ và trái cây")"
                 width="720" height="640" decoding="async" fetchpriority="high" />
            @if (!hasImage)
            {
                <span class="store-photo-caption">Ảnh minh họa</span>
            }
        </div>
        @if (!hasImage)
        {
            <p class="store-detail-photo-note">Sản phẩm chưa có ảnh riêng. Hình nông sản phía trên chỉ dùng minh họa.</p>
        }
    </div>
    <div class="store-detail-copy">
        <span class="store-detail-category">@Model.Product.CategoryName</span>
        <h1>@Model.Product.Name</h1>
        <p class="store-detail-stock @(Model.Product.Stock <= 0 ? "is-empty" : "")"><span aria-hidden="true"></span>@(Model.Product.Stock > 0 ? $"Còn {Model.Product.Stock} {Model.Product.Unit}" : "Sản phẩm tạm hết hàng")</p>
        <div class="store-detail-price-box"><span class="store-detail-price-label">Giá bán</span><p class="store-detail-price">@Model.Product.Price.ToString("#,0.##", CultureInfo.GetCultureInfo("vi-VN")) <span>₫ / @Model.Product.Unit</span></p><span class="store-detail-fee-note">Phí giao hàng được hiển thị tại bước đặt hàng.</span></div>
        @if (Model.Product.Stock > 0)
        {
            @if (User.Identity?.IsAuthenticated == true)
            {
            <form asp-controller="Cart" asp-action="Add" method="post" class="store-buy-form">
                <input type="hidden" name="productId" value="@Model.Product.Id" />
                <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Catalog", new { id = Model.Product.Id })" />
                <label for="product-quantity">Số lượng <span>(@Model.Product.Unit)</span></label>
                <div>
                    <input id="product-quantity" name="quantity" type="number" min="1" max="@(Math.Min(Model.Product.Stock, 1000))" value="1" required class="form-control" inputmode="numeric" />
                    <button type="submit" class="store-button"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>Thêm vào giỏ hàng</button>
                </div>
            </form>
            }
            else
            {
                <div class="store-guest-purchase"><p>Đăng nhập để chọn số lượng, lưu giỏ hàng và đặt mua nông sản.</p><a class="store-button w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Catalog", new { id = Model.Product.Id })">Đăng nhập để thêm vào giỏ</a></div>
            }
        }
        else
        {
            <div class="store-unavailable-note"><strong>Chưa thể đặt mua lúc này</strong><p>Hãy quay lại sau hoặc khám phá những sản phẩm đang có tại cửa hàng.</p><a class="store-button store-button-outline" asp-action="Index">Khám phá sản phẩm khác</a></div>
        }
        <div class="store-detail-reassurance">
            <div><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 12 4 4 8-8"/><rect x="3" y="3" width="18" height="18" rx="5"/></svg><span><strong>Thông tin rõ ràng</strong><span>Giá bán và đơn vị được niêm yết theo sản phẩm.</span></span></div>
            <div><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18v13H3V6Zm0 4h18m-14 5h4"/></svg><span><strong>Thanh toán COD</strong><span>Thanh toán khi nhận hàng, không yêu cầu thông tin thẻ.</span></span></div>
            <div><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 3h8v4H8V3ZM6 5H4v16h16V5h-2M8 12h8m-8 4h5"/></svg><span><strong>Theo dõi đơn thuận tiện</strong><span>Kiểm tra tiến trình trong tài khoản của bạn.</span></span></div>
        </div>
    </div>
    <section class="store-product-information" aria-labelledby="product-description-title">
        <h2 id="product-description-title">Thông tin sản phẩm</h2>
        <div class="store-detail-description">@Model.Description</div>
        <p class="store-product-information-unit"><strong>Đơn vị bán:</strong> @Model.Product.Unit</p>
    </section>
</article>
@if (Model.RelatedProducts.Count > 0)
{
    <section class="store-section store-related-products" aria-labelledby="related-title">
        <div class="store-section-heading"><div><p class="store-eyebrow">THÊM LỰA CHỌN CHO BỮA ĂN</p><h2 id="related-title">Cùng danh mục</h2></div><a asp-action="Index">Xem cửa hàng <span aria-hidden="true">→</span></a></div>
        <div class="store-product-grid">
            @foreach (var product in Model.RelatedProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>
}
