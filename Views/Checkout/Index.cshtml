@using System.Globalization
@model WEB_BAN_NONG_SAN.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Đặt hàng COD";
}
<section class="commerce-page">
    <div class="commerce-heading"><div><p class="eyebrow">BƯỚC CUỐI CÙNG</p><h1>Xác nhận đơn hàng</h1><p>Thanh toán bằng tiền mặt khi nhận hàng (COD).</p></div><a class="btn btn-outline-secondary" asp-controller="Cart" asp-action="Index">Trở lại giỏ hàng</a></div>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (!Model.IsAvailable) { <div class="alert alert-warning">Chưa tải được dữ liệu đặt hàng. Vui lòng thử lại sau.</div> }
    else if (!Model.Cart.CanCheckout)
    {
        <div class="alert alert-warning">Giỏ hàng đang trống hoặc có sản phẩm không khả dụng. Vui lòng kiểm tra lại.</div>
        <a class="btn btn-primary" asp-controller="Cart" asp-action="Index">Kiểm tra giỏ hàng</a>
    }
    else
    {
        <div class="row g-4"><div class="col-lg-7">
            <div class="commerce-card p-4 mb-4"><h2 class="h4">Mã giảm giá</h2>
                <form asp-action="Index" method="get" class="d-flex gap-2"><label class="visually-hidden" for="couponCode">Mã giảm giá</label><input id="couponCode" class="form-control" name="couponCode" value="@Model.Input.CouponCode" maxlength="50" placeholder="Nhập mã nếu có" /><button class="btn btn-outline-secondary" type="submit">Kiểm tra</button></form>
                @if (Model.CouponMessage is not null) { <p class="mt-2 mb-0" role="status">@Model.CouponMessage</p> }
            </div>
            <form asp-action="PlaceOrder" method="post" id="checkout-form" class="commerce-card p-4">
                <input asp-for="Input.CheckoutToken" type="hidden" /><input asp-for="Input.CouponCode" type="hidden" />
                <h2 class="h4">Địa chỉ nhận hàng</h2>
                @if (Model.Addresses.Count == 0)
                {
                    <p>Vui lòng thêm địa chỉ nhận hàng trước khi đặt đơn.</p><a class="btn btn-primary" asp-controller="Addresses" asp-action="Create">Thêm địa chỉ giao hàng</a>
                }
                else
                {
                    <fieldset><legend class="visually-hidden">Chọn địa chỉ nhận hàng</legend>
                    @foreach (var address in Model.Addresses)
                    {
                        <div class="form-check border rounded p-3 ps-5 mb-3"><input class="form-check-input" asp-for="Input.AddressId" type="radio" id="address-@address.Id" value="@address.Id" /><label class="form-check-label" for="address-@address.Id"><strong>@address.RecipientName</strong> · @address.PhoneNumber<br />@address.FullAddress @if (address.IsDefault) { <span class="badge text-bg-light">Mặc định</span> }</label></div>
                    }
                    </fieldset>
                    <p><a asp-controller="Addresses" asp-action="Index">Quản lý địa chỉ</a></p>
                    <p class="small text-muted">Thông tin sản phẩm và địa chỉ được lưu theo thời điểm đặt hàng. Giá, tồn kho và mã giảm giá được kiểm tra lại trên máy chủ.</p>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Đặt hàng · Thanh toán khi nhận</button>
                }
            </form>
        </div><aside class="col-lg-5"><div class="commerce-card p-4"><h2 class="h4">Đơn hàng của bạn</h2>
            @foreach (var item in Model.Cart.Items)
            {
                <div class="d-flex justify-content-between gap-3 border-bottom py-3"><span>@item.Name <small class="d-block text-muted">@item.Quantity @item.Unit × @item.UnitPrice.ToString("N2", CultureInfo.GetCultureInfo("vi-VN")) đ</small></span><strong>@item.LineTotal.ToString("N2", CultureInfo.GetCultureInfo("vi-VN")) đ</strong></div>
            }
            <dl class="row mt-4"><dt class="col-7">Tạm tính</dt><dd class="col-5 text-end">@Model.Cart.Subtotal.ToString("N2", CultureInfo.GetCultureInfo("vi-VN")) đ</dd><dt class="col-7">Phí vận chuyển cố định</dt><dd class="col-5 text-end">@Model.ShippingFee.ToString("N2", CultureInfo.GetCultureInfo("vi-VN")) đ</dd><dt class="col-7">Giảm giá</dt><dd class="col-5 text-end">−@Model.Discount.ToString("N2", CultureInfo.GetCultureInfo("vi-VN")) đ</dd><dt class="col-7 fs-5">Tổng thanh toán</dt><dd class="col-5 text-end fw-bold fs-5">@Model.Total.ToString("N2", CultureInfo.GetCultureInfo("vi-VN")) đ</dd></dl>
            <p class="small text-muted">COD · Chưa thanh toán. Không yêu cầu thông tin thẻ hoặc chuyển khoản trực tuyến.</p>
        </div></aside></div>
    }
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
