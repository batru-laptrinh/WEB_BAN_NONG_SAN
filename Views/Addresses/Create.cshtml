@model WEB_BAN_NONG_SAN.ViewModels.AddressFormViewModel
@{ ViewData["Title"] = "Thêm địa chỉ giao hàng"; }
@section Styles { <link rel="stylesheet" href="~/css/addresses.css" asp-append-version="true" /> }
<section class="address-page address-form-page">
    <a asp-action="Index" class="address-back">← Sổ địa chỉ</a>
    <p class="address-eyebrow">THÊM NƠI NHẬN HÀNG</p><h1>Địa chỉ giao hàng mới</h1><p class="address-intro">Nhập địa chỉ hiện hành của bạn. Các trường có dấu * là bắt buộc. Mỗi tài khoản lưu tối đa 50 địa chỉ.</p>
    <form asp-action="Create" method="post" class="address-form-card">
        <partial name="_Form" model="Model" />
        <div class="address-form-actions"><button class="address-button" type="submit">Lưu địa chỉ</button><a asp-action="Index" class="address-button address-button-secondary">Hủy</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
