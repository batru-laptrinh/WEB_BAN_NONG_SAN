@model WEB_BAN_NONG_SAN.ViewModels.AddressDeleteViewModel
@{ ViewData["Title"] = "Xác nhận xóa địa chỉ"; var address = Model.Address; }
@section Styles { <link rel="stylesheet" href="~/css/addresses.css" asp-append-version="true" /> }
<section class="address-page address-form-page">
    <a asp-action="Index" class="address-back">← Sổ địa chỉ</a>
    <p class="address-eyebrow">XÁC NHẬN THAO TÁC</p><h1>Xóa địa chỉ này?</h1>
    <div class="address-form-card">
        <h2>@(address.Label ?? "Địa chỉ giao hàng")</h2><p><strong>@address.RecipientName</strong><br />@address.PhoneNumber</p>
        <p class="address-location">@address.AddressLine<br />@address.Ward@if (!string.IsNullOrEmpty(address.District)) {<text>, @address.District</text>}<text>, @address.Province</text></p>
        @if (address.IsDefault) { <div class="address-default-info">Đây là địa chỉ mặc định. Sau khi xóa, địa chỉ được thêm sớm nhất còn lại sẽ trở thành mặc định.</div> }
        <p class="address-policy">Chỉ địa chỉ này bị xóa khỏi sổ địa chỉ. Tài khoản và các đơn hàng đã đặt được giữ nguyên.</p>
        <form asp-action="Delete" asp-route-id="@address.Id" method="post"><input type="hidden" name="confirmation" value="@Model.Confirmation" /><div class="address-form-actions"><button class="address-button address-button-danger" type="submit">Xác nhận xóa</button><a asp-action="Index" class="address-button address-button-secondary">Giữ địa chỉ</a></div></form>
    </div>
</section>
