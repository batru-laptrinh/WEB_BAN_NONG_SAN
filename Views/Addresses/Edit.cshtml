@model WEB_BAN_NONG_SAN.ViewModels.AddressFormViewModel
@{ ViewData["Title"] = "Chỉnh sửa địa chỉ"; }
@section Styles { <link rel="stylesheet" href="~/css/addresses.css" asp-append-version="true" /> }
<section class="address-page address-form-page">
    <a asp-action="Index" class="address-back">← Sổ địa chỉ</a>
    <p class="address-eyebrow">CẬP NHẬT NƠI NHẬN HÀNG</p><h1>Chỉnh sửa địa chỉ</h1><p class="address-intro">Các trường có dấu * là bắt buộc. Kiểm tra thông tin trước khi lưu.</p>
    <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="address-form-card">
        <input asp-for="VersionToken" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="address-form-actions"><button class="address-button" type="submit">Lưu thay đổi</button><a asp-action="Index" class="address-button address-button-secondary">Quay lại danh sách</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
