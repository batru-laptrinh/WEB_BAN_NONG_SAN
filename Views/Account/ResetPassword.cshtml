@model WEB_BAN_NONG_SAN.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Đặt lại mật khẩu"; }
<section class="auth-shell">
    <aside class="auth-intro" aria-label="Mua sắm tại Nông Sản">
        <div class="auth-intro-copy"><p class="account-eyebrow">CHO BỮA ĂN MỖI NGÀY</p><h2>Mua sắm gọn gàng.<br />Bữa cơm thêm đủ đầy.</h2><p>Lưu địa chỉ nhận hàng, chọn nông sản và theo dõi đơn mua trong cùng một tài khoản.</p></div>
        <img class="auth-produce-photo" src="~/images/agriculture-harvest.webp" alt="Rau củ và trái cây tươi, hình ảnh minh họa nông sản" width="720" height="800" loading="lazy" />
        <div class="auth-intro-bottom"><span>Thông tin sản phẩm rõ ràng</span><span>Thanh toán khi nhận hàng</span></div>
    </aside>
    <div class="auth-card">
        <a class="auth-brand-link" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ Nông Sản"><partial name="_Brand" /></a>
        <p class="account-eyebrow">TÀI KHOẢN CỦA BẠN</p><h1>Đặt lại mật khẩu</h1><p class="account-description">Chọn một mật khẩu mới để khôi phục quyền truy cập tài khoản của bạn.</p>
        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="account-form">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
            <div asp-validation-summary="All" class="account-validation" role="alert"></div>
            <div class="account-field"><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Nhập mật khẩu mới" class="form-control" /><span asp-validation-for="NewPassword" class="field-validation-text"></span></div>
            <div class="account-field"><label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" class="form-control" /><span asp-validation-for="ConfirmPassword" class="field-validation-text"></span></div>
            <p class="account-help">Mật khẩu có ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
            <button type="submit" class="store-button account-submit">Xác nhận đặt lại mật khẩu</button>
        </form>
        <p class="account-footer-link"><a asp-controller="Account" asp-action="Login">← Quay lại đăng nhập</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
