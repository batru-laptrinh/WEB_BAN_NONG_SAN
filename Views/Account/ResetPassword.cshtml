
@model WEB_BAN_NONG_SAN.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="text-center text-success fw-bold mb-3">
                        Đặt lại mật khẩu
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Vui lòng nhập mật khẩu mới
                        để khôi phục tài khoản của bạn.
                    </p>

                    <form asp-controller="Account"
                          asp-action="ResetPassword"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Thông tin từ liên kết khôi phục -->
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu mới"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="Nhập lại mật khẩu mới"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Yêu cầu mật khẩu -->
                        <div class="alert alert-info small">
                            Mật khẩu phải có ít nhất 8 ký tự,
                            bao gồm chữ hoa, chữ thường,
                            chữ số và ký tự đặc biệt.
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100 py-2 fw-semibold">
                            Xác nhận đặt lại mật khẩu
                        </button>

                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-success text-decoration-none fw-semibold">
                            Quay lại đăng nhập
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
