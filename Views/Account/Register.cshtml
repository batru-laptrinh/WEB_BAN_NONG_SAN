
@model WEB_BAN_NONG_SAN.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="text-center text-success fw-bold mb-2">
                        Đăng ký tài khoản
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Chào mừng bạn đến với Nông Sản Sạch!
                    </p>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName"
                                   class="form-label fw-semibold">
                                Họ và tên
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Nhập họ và tên"
                                   autocomplete="name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Nhập email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Mật khẩu
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Xác nhận mật khẩu
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   placeholder="Nhập lại mật khẩu"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100 py-2 fw-semibold">
                            Đăng ký
                        </button>

                    </form>

                    <p class="text-center mt-4 mb-0">
                        Đã có tài khoản?
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-success fw-semibold">
                            Đăng nhập
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
