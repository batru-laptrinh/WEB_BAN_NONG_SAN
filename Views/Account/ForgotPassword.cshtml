
@model WEB_BAN_NONG_SAN.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="text-success fw-bold">
                            Quên mật khẩu?
                        </h2>

                        <p class="text-muted">
                            Nhập địa chỉ email đã đăng ký.
                            Chúng tôi sẽ gửi liên kết
                            giúp bạn đặt lại mật khẩu.
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="ForgotPassword"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Nhập địa chỉ email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100 py-2 fw-semibold">
                            Gửi liên kết đặt lại mật khẩu
                        </button>

                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="text-success text-decoration-none fw-semibold">
                            Quay lại đăng nhập
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
