@model WEB_BAN_NONG_SAN.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu?"; }
<section class="auth-shell">
    <aside class="auth-intro" aria-label="Mua sắm tại Nông Sản">
        <div class="auth-intro-copy"><p class="account-eyebrow">CHO BỮA ĂN MỖI NGÀY</p><h2>Mua sắm gọn gàng.<br />Bữa cơm thêm đủ đầy.</h2><p>Lưu địa chỉ nhận hàng, chọn nông sản và theo dõi đơn mua trong cùng một tài khoản.</p></div>
        <img class="auth-produce-photo" src="~/images/agriculture-harvest.webp" alt="Rau củ và trái cây tươi, hình ảnh minh họa nông sản" width="720" height="800" loading="lazy" />
        <div class="auth-intro-bottom"><span>Thông tin sản phẩm rõ ràng</span><span>Thanh toán khi nhận hàng</span></div>
    </aside>
    <div class="auth-card">
        <a class="auth-brand-link" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ Nông Sản"><partial name="_Brand" /></a>
        <p class="account-eyebrow">TÀI KHOẢN CỦA BẠN</p><h1>Quên mật khẩu?</h1><p class="account-description">Nhập địa chỉ email đã đăng ký. Chúng tôi sẽ gửi liên kết giúp bạn đặt lại mật khẩu.</p>
        @if (TempData["ForgotPasswordMessage"] is string message) { <div class="alert alert-info" role="status">@message</div> }
        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>
            <div class="account-field"><label asp-for="Email">Email đã đăng ký</label><input asp-for="Email" type="email" autocomplete="email" placeholder="Nhập email của bạn" class="form-control" /><span asp-validation-for="Email" class="field-validation-text"></span></div>
            <button type="submit" class="store-button account-submit">Gửi liên kết đặt lại mật khẩu</button>
        </form>
        <p class="account-footer-link"><a asp-controller="Account" asp-action="Login">← Quay lại đăng nhập</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
