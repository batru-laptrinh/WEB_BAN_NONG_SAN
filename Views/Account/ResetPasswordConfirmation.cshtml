
@{
    ViewData["Title"] = "Thông báo đặt lại mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5 text-center">

                    <!-- Biểu tượng -->
                    <div class="mb-4">
                        <span class="d-inline-flex align-items-center
                                     justify-content-center
                                     bg-success bg-opacity-10
                                     text-success rounded-circle"
                              style="width: 80px; height: 80px;">

                            <i class="fs-1">✓</i>
                        </span>
                    </div>

                    <!-- Tiêu đề -->
                    <h2 class="text-success fw-bold mb-3">
                        Yêu cầu đã được xử lý
                    </h2>

                    <!-- Nội dung thông báo -->
                    <p class="text-muted mb-4">
                        Nếu tài khoản tồn tại và liên kết
                        khôi phục hợp lệ, mật khẩu của bạn
                        đã được cập nhật.

                        Bạn có thể thử đăng nhập bằng
                        mật khẩu mới.
                    </p>

                    <!-- Nút đăng nhập -->
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-success w-100 py-2 fw-semibold">
                        Quay lại đăng nhập
                    </a>

                    <!-- Yêu cầu liên kết mới -->
                    <div class="mt-4">
                        <p class="text-muted mb-2">
                            Bạn vẫn chưa đăng nhập được?
                        </p>

                        <a asp-controller="Account"
                           asp-action="ForgotPassword"
                           class="text-success text-decoration-none
                                  fw-semibold">
                            Yêu cầu liên kết khôi phục mới
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
