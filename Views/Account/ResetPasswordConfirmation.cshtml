@{ ViewData["Title"] = "Thông báo đặt lại mật khẩu"; }
<section class="account-result-card">
    <a class="auth-brand-link" asp-controller="Home" asp-action="Index"><partial name="_Brand" /></a>
    <span class="account-result-symbol" aria-hidden="true">✓</span><p class="account-eyebrow">THÔNG BÁO TÀI KHOẢN</p><h1>Yêu cầu đã được xử lý</h1>
    <p>Nếu tài khoản tồn tại và liên kết khôi phục hợp lệ, mật khẩu của bạn đã được cập nhật. Bạn có thể thử đăng nhập bằng mật khẩu mới.</p>
    <a asp-controller="Account" asp-action="Login" class="store-button account-submit">Quay lại đăng nhập</a>
    <p class="account-footer-link">Bạn vẫn chưa đăng nhập được?<br /><a asp-controller="Account" asp-action="ForgotPassword">Yêu cầu liên kết khôi phục mới</a></p>
</section>
