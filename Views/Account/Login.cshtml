@model WEB_BAN_NONG_SAN.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; var returnUrl = ViewData["ReturnUrl"] as string; }
<section class="auth-shell">
    <aside class="auth-intro" aria-label="Mua sắm tại Nông Sản">
        <div class="auth-intro-copy"><p class="account-eyebrow">CHO BỮA ĂN MỖI NGÀY</p><h2>Mua sắm gọn gàng.<br />Bữa cơm thêm đủ đầy.</h2><p>Lưu địa chỉ nhận hàng, chọn nông sản và theo dõi đơn mua trong cùng một tài khoản.</p></div>
        <img class="auth-produce-photo" src="~/images/agriculture-harvest.webp" alt="Rau củ và trái cây tươi, hình ảnh minh họa nông sản" width="720" height="800" loading="lazy" />
        <div class="auth-intro-bottom"><span>Thông tin sản phẩm rõ ràng</span><span>Thanh toán khi nhận hàng</span></div>
    </aside>
    <div class="auth-card">
        <a class="auth-brand-link" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ Nông Sản"><partial name="_Brand" /></a>
        <p class="account-eyebrow">TÀI KHOẢN CỦA BẠN</p><h1>Đăng nhập</h1><p class="account-description">Chào mừng bạn quay lại. Tiếp tục chọn nông sản cho bữa ăn gia đình.</p>
        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>
            <div class="account-field"><label asp-for="Email">Email</label><input asp-for="Email" type="email" autocomplete="username" placeholder="ban@example.com" class="form-control" /><span asp-validation-for="Email" class="field-validation-text"></span></div>
            <div class="account-field"><label asp-for="Password">Mật khẩu</label><input asp-for="Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu của bạn" class="form-control" /><span asp-validation-for="Password" class="field-validation-text"></span></div>
            <div class="account-form-options"><div class="form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label></div><a asp-controller="Account" asp-action="ForgotPassword">Quên mật khẩu?</a></div>
            <button type="submit" class="store-button account-submit">Đăng nhập <span aria-hidden="true">→</span></button>
        </form>
        <p class="account-footer-link">Chưa có tài khoản? <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
