@model WEB_BAN_NONG_SAN.ViewModels.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<nav class="store-breadcrumb" aria-label="Đường dẫn"><a asp-controller="Home" asp-action="Index">Trang chủ</a><span aria-hidden="true">/</span><a asp-controller="Profile" asp-action="Index">Tài khoản</a><span aria-hidden="true">/</span><span aria-current="page">Đổi mật khẩu</span></nav>
<section class="account-shell">
    <aside class="account-sidebar"><p class="account-eyebrow">KHÔNG GIAN CỦA BẠN</p><h2>Tài khoản</h2><p>Quản lý thông tin và những đơn mua trong cùng một nơi.</p><nav class="account-navigation" aria-label="Điều hướng tài khoản"><a asp-controller="Profile" asp-action="Index" >Hồ sơ cá nhân <span aria-hidden="true">→</span></a><a asp-controller="Addresses" asp-action="Index">Địa chỉ giao hàng <span aria-hidden="true">→</span></a><a asp-controller="Orders" asp-action="Index">Đơn hàng của tôi <span aria-hidden="true">→</span></a><a asp-controller="Account" asp-action="ChangePassword" class="is-active" aria-current="page">Đổi mật khẩu <span aria-hidden="true">→</span></a></nav><div class="account-sidebar-note"><strong>Tiếp tục chọn nông sản</strong><p>Khám phá những sản phẩm đang có tại cửa hàng.</p><a asp-controller="Catalog" asp-action="Index">Đến cửa hàng →</a></div></aside>
    <div class="account-content"><header class="account-content-heading"><p class="account-eyebrow">BẢO MẬT TÀI KHOẢN</p><h1>Đổi mật khẩu</h1><p>Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p></header>
        <div class="account-panel">
            @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success" role="status">@TempData["SuccessMessage"]</div> }
            <form asp-controller="Account" asp-action="ChangePassword" method="post" class="account-form">
                <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>
            <div class="account-field"><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu hiện tại" class="form-control" /><span asp-validation-for="CurrentPassword" class="field-validation-text"></span></div>
            <div class="account-field"><label asp-for="NewPassword">Mật khẩu mới</label><input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Nhập mật khẩu mới" class="form-control" /><span asp-validation-for="NewPassword" class="field-validation-text"></span></div>
            <div class="account-field"><label asp-for="ConfirmNewPassword">Xác nhận mật khẩu mới</label><input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" class="form-control" /><span asp-validation-for="ConfirmNewPassword" class="field-validation-text"></span></div>
                <div class="account-info-note">Mật khẩu mới phải có ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</div>
                <div class="account-panel-actions"><button type="submit" class="store-button">Cập nhật mật khẩu</button><a asp-controller="Profile" asp-action="Index">Quay lại hồ sơ cá nhân</a></div>
            </form>
        </div>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
