
@model WEB_BAN_NONG_SAN.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="text-center text-success fw-bold mb-3">
                        Đổi mật khẩu
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Cập nhật mật khẩu để bảo vệ tài khoản của bạn
                    </p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <form asp-controller="Account"
                          asp-action="ChangePassword"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-3">
                            <label asp-for="CurrentPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="CurrentPassword"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu hiện tại"
                                   autocomplete="current-password" />

                            <span asp-validation-for="CurrentPassword"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu mới"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Xác nhận mật khẩu mới -->
                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ConfirmNewPassword"
                                   class="form-control"
                                   placeholder="Nhập lại mật khẩu mới"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmNewPassword"
                                  class="text-danger small"></span>
                        </div>

                        <div class="alert alert-info small">
                            Mật khẩu mới phải có ít nhất 8 ký tự,
                            gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                        </div>

                        <!-- Nút lưu mật khẩu -->
                        <button type="submit"
                                class="btn btn-success w-100 py-2 fw-semibold">
                            Cập nhật mật khẩu
                        </button>

                    </form>

                    <div class="text-center mt-4">
                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="text-success text-decoration-none">
                            Quay lại hồ sơ cá nhân
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
