@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container mt-4">
    <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="badge bg-success-subtle text-success px-3 py-2 mb-2 fw-bold">Câu chuyện của chúng tôi</span>
                <h2 class="fw-bold text-success mb-3">Nông Sản Xanh - Vì Sức Khỏe Gia Đình Việt</h2>
                <p class="text-muted">Nông Sản Xanh được thành lập với sứ mệnh kết nối trực tiếp các nông trại canh tác chuẩn VietGAP, GlobalGAP và Hữu cơ tại Việt Nam đến tận tay người tiêu dùng.</p>
                <p class="text-muted">Chúng tôi cam kết minh bạch nguồn gốc xuất xứ, thu hoạch và vận chuyển lạnh trong ngày để giữ trọn vẹn hương vị tươi ngon cùng hàm lượng dinh dưỡng tự nhiên.</p>
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=900&q=80"
                     class="img-fluid rounded-4 shadow-sm" alt="Giới thiệu Nông Sản Xanh" />
            </div>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-md-4">
                <div class="p-4 border rounded-4 h-100 bg-light">
                    <i class="bi bi-shield-check fs-1 text-success"></i>
                    <h5 class="fw-bold mt-2">100% An Toàn & Sạch</h5>
                    <p class="small text-muted mb-0">Kiểm định nghiêm ngặt, nói không với chất bảo quản và thuốc trừ sâu độc hại.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 border rounded-4 h-100 bg-light">
                    <i class="bi bi-truck fs-1 text-success"></i>
                    <h5 class="fw-bold mt-2">Giao Nhanh Trong 2H</h5>
                    <p class="small text-muted mb-0">Bảo quản mát xuyên suốt quá trình giao hàng, đổi trả miễn phí nếu không tươi ngon.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4 border rounded-4 h-100 bg-light">
                    <i class="bi bi-heart-pulse fs-1 text-success"></i>
                    <h5 class="fw-bold mt-2">Đồng Hành Cùng Nông Dân</h5>
                    <p class="small text-muted mb-0">Bao tiêu đầu ra ổn định cho bà con nông dân các vùng chuyên canh nông nghiệp sạch.</p>
                </div>
            </div>
        </div>
    </div>
</div>