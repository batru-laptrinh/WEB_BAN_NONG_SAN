@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan quản trị";
    var checkedAt = Model.CheckedAtUtc.ToOffset(TimeSpan.FromHours(7));
}
<div class="admin-dashboard">
    <section class="admin-page-heading" aria-labelledby="dashboard-title">
        <div>
            <p class="admin-eyebrow">GÓC NHÌN TỔNG THỂ</p>
            <h1 id="dashboard-title">Tổng quan quản trị</h1>
            <p class="admin-page-description">Theo dõi tài khoản, đơn hàng và kết quả kinh doanh từ dữ liệu hiện tại.</p>
        </div>
        <div class="admin-updated-at">
            <svg class="admin-icon" aria-hidden="true"><use href="#admin-clock"></use></svg>
            <span>Lần kiểm tra này<time datetime="@Model.CheckedAtUtc.ToString("O")">@checkedAt.ToString("HH:mm · dd/MM/yyyy") <small>UTC+7</small></time></span>
        </div>
    </section>

    <div class="admin-overview-grid">
        <section class="admin-customer-card" aria-labelledby="customer-card-title">
            <div class="admin-customer-heading"><span class="admin-customer-icon"><svg class="admin-icon" aria-hidden="true"><use href="#admin-users"></use></svg></span><span class="admin-card-kicker">TÀI KHOẢN</span></div>
            <h2 id="customer-card-title">Tài khoản Customer</h2>
            @if (Model.IsDataAvailable)
            {
                <strong class="admin-customer-count" data-testid="customer-count">@Model.CustomerCount!.Value.ToString("N0", CultureInfo.GetCultureInfo("vi-VN"))</strong>
                <p class="admin-customer-caption">Tài khoản có vai trò Customer trong hệ thống.</p>
                <div class="admin-customer-source"><span class="admin-status-dot" aria-hidden="true"></span>Dữ liệu tài khoản hiện tại</div>
            }
            else
            {
                <strong class="admin-count-unavailable" data-testid="customer-count">Chưa tải được</strong>
                <p class="admin-customer-caption">Tạm thời chưa đọc được số tài khoản. Vui lòng tải lại trang sau.</p>
                <div class="admin-customer-source"><svg class="admin-icon" aria-hidden="true"><use href="#admin-alert"></use></svg>Dữ liệu đang không khả dụng</div>
            }
            <p class="admin-count-note">Bao gồm quản trị viên đang có thêm vai trò Customer.</p>
            <svg class="admin-customer-decoration" aria-hidden="true"><use href="#admin-leaf"></use></svg>
        </section>

        <section class="admin-panel admin-system-panel" aria-labelledby="system-title">
            <div class="admin-panel-heading"><div><p class="admin-eyebrow">TRẠNG THÁI</p><h2 id="system-title">Hoạt động hệ thống</h2></div><span class="admin-soft-icon"><svg class="admin-icon" aria-hidden="true"><use href="#admin-shield"></use></svg></span></div>
            <ul class="admin-system-list">
                <li><span class="admin-system-label"><svg class="admin-icon" aria-hidden="true"><use href="#admin-user"></use></svg>Tài khoản quản trị</span><span class="admin-state-pill">Đã đăng nhập</span></li>
                <li><span class="admin-system-label"><svg class="admin-icon" aria-hidden="true"><use href="#admin-lock"></use></svg>Quyền truy cập</span><span class="admin-state-pill">Admin</span></li>
                <li><span class="admin-system-label"><svg class="admin-icon" aria-hidden="true"><use href="#admin-users"></use></svg>Dữ liệu tài khoản</span><span class="admin-state-pill @(Model.IsDataAvailable ? "" : "is-unavailable")">@(Model.IsDataAvailable ? "Đã đọc dữ liệu" : "Chưa khả dụng")</span></li>
            </ul>
            <p class="admin-system-note"><svg class="admin-icon" aria-hidden="true"><use href="#admin-check"></use></svg>Quyền quản trị được kiểm tra khi truy cập.</p>
        </section>
    </div>

    <section class="admin-quick-section" aria-labelledby="quick-title">
        <div class="admin-section-heading"><div><p class="admin-eyebrow">THAO TÁC THƯỜNG DÙNG</p><h2 id="quick-title">Quản lý nhanh</h2></div><span class="admin-section-caption">Các chức năng hiện có</span></div>
        <div class="admin-quick-grid">
            <a asp-area="" asp-controller="Profile" asp-action="Index" class="admin-quick-card"><span class="admin-quick-icon"><svg class="admin-icon" aria-hidden="true"><use href="#admin-user"></use></svg></span><span><strong>Hồ sơ tài khoản</strong><small>Xem và cập nhật thông tin cá nhân.</small></span><svg class="admin-icon admin-quick-arrow" aria-hidden="true"><use href="#admin-arrow"></use></svg></a>
            <a asp-area="" asp-controller="Account" asp-action="ChangePassword" class="admin-quick-card"><span class="admin-quick-icon"><svg class="admin-icon" aria-hidden="true"><use href="#admin-lock"></use></svg></span><span><strong>Đổi mật khẩu</strong><small>Quản lý bảo mật tài khoản của bạn.</small></span><svg class="admin-icon admin-quick-arrow" aria-hidden="true"><use href="#admin-arrow"></use></svg></a>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-quick-card"><span class="admin-quick-icon"><svg class="admin-icon" aria-hidden="true"><use href="#admin-home"></use></svg></span><span><strong>Trở về website</strong><small>Truy cập giao diện dành cho khách hàng.</small></span><svg class="admin-icon admin-quick-arrow" aria-hidden="true"><use href="#admin-arrow"></use></svg></a>
        </div>
    </section>

    <section class="admin-panel admin-business-panel" aria-labelledby="business-title">
        <div class="admin-panel-heading"><div><p class="admin-eyebrow">KINH DOANH</p><h2 id="business-title">Sản phẩm, đơn hàng &amp; doanh thu</h2></div><a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary">Xem báo cáo</a></div>
        @if (Model.ProductCount.HasValue)
        {
            <div class="commerce-stats">
                <div><small>Sản phẩm trong hệ thống</small><strong data-testid="product-count">@Model.ProductCount</strong></div>
                <div><small>Tổng đơn hàng</small><strong data-testid="order-count">@Model.OrderCount</strong></div>
                <div><small>Đơn chờ xác nhận</small><strong>@Model.PendingOrderCount</strong></div>
                <div><small>Đơn hoàn thành</small><strong>@Model.CompletedOrderCount</strong></div>
                <div><small>Doanh thu COD đã hoàn thành</small><strong data-testid="completed-revenue">@Model.CompletedRevenue?.ToString("#,##0.##", CultureInfo.GetCultureInfo("vi-VN")) ₫</strong></div>
            </div>
            @if (Model.OrderCount == 0) { <p class="text-muted">Chưa có đơn hàng. Thống kê hiển thị dữ liệu hiện tại.</p> }
            <p class="text-muted small">Doanh thu gồm tổng tiền các đơn hoàn thành và đã thu COD, bao gồm phí giao hàng sau giảm giá.</p>
        }
        else
        {
            <p role="status">Chưa tải được thống kê bán hàng. Hãy kiểm tra Migration và thử lại sau.</p>
        }
    </section>
</div>
